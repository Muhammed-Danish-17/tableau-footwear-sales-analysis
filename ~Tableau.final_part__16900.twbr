      </column>
      <column datatype='string' name='[Brand]' role='dimension' type='nominal' />
      <column caption='Total Customers' datatype='integer' name='[Calculation_0179013482115072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Customer_ID])' />
      </column>
      <column caption='Average Discount %' datatype='real' name='[Calculation_0179013483458562]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Discount_Pct])' />
      </column>
      <column caption='Profit Margin %' datatype='real' name='[Calculation_0179013503594499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Net_Revenue_USD]) = 0 THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    SUM([Profit_USD]) / SUM([Net_Revenue_USD])&#13;&#10;END' />
      </column>
      <column caption='Orders per Customer' datatype='integer' name='[Calculation_0179013512900612]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Customer_ID] :&#13;&#10;    COUNTD([Order_ID])&#13;&#10;}' />
      </column>
      <column caption='Total Returned Orders' datatype='integer' name='[Calculation_0331845958483968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Order_ID (footwear!returns)])' />
      </column>
      <column caption='Total Refund Amount' datatype='real' name='[Calculation_0331845958651905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Refund_Amount_USD])' />
      </column>
      <column caption='Average Shipping Days' datatype='real' name='[Calculation_0331845958770690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Days_to_Ship])' />
      </column>
      <column caption='Total Shipping Cost' datatype='real' name='[Calculation_0331845958877187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Shipping_Cost_USD])' />
      </column>
      <column caption='Order Year' datatype='integer' name='[Calculation_0920906985238528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([Order_Date])' />
      </column>
      <column caption='Order Quarter' datatype='string' name='[Calculation_0920906985496577]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [Order_Date]))' />
      </column>
      <column caption='Sales Growth %' datatype='real' name='[Calculation_1115796012175360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL(LOOKUP(SUM([Net_Revenue_USD]), -1))&#13;&#10;OR LOOKUP(SUM([Net_Revenue_USD]), -1) = 0&#13;&#10;THEN NULL&#13;&#10;ELSE&#13;&#10;(&#13;&#10;    SUM([Net_Revenue_USD])&#13;&#10;    - LOOKUP(SUM([Net_Revenue_USD]), -1)&#13;&#10;)&#13;&#10;/&#13;&#10;ABS(LOOKUP(SUM([Net_Revenue_USD]), -1))&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Target Attainment %' datatype='real' name='[Calculation_1403594350133248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Net_Revenue_USD])&#13;&#10;/&#13;&#10;SUM([Target_Net_Revenue_USD])' />
      </column>
      <column caption='Total Revenue' datatype='real' name='[Calculation_1534159812132864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Net_Revenue_USD])' />
      </column>
      <column caption='Total Profit' datatype='real' name='[Calculation_1534159812284417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit_USD])' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_1534159812485122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order_ID])' />
