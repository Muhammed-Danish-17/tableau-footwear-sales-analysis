            <column-instance column='[Calculation_0141564194115590]' derivation='None' name='[none:Calculation_0141564194115590:nk]' pivot='key' type='nominal' />
            <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
