            <format attr='text-format' field='[federated.0j495kw0i1sa6810dumqo0buc8yy].[sum:Target_Net_Revenue_USD:qk]' value='c&quot;$&quot;#,##0,,.00M;&quot;$&quot;-#,##0,,.00M' />
