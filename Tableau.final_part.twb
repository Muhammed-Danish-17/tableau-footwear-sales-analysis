    <worksheet name='RFM Segments'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Benton Sans Book'>Customers by RFM Segment</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='footwear_orders_100k+ (footwear_extra_dimension_tables)' name='federated.0j495kw0i1sa6810dumqo0buc8yy' />
          </datasources>
          <datasource-dependencies datasource='federated.0j495kw0i1sa6810dumqo0buc8yy'>
            <column datatype='string' name='[Brand]' role='dimension' type='nominal' />
            <column caption='Recency (days)' datatype='integer' name='[Calculation_0141564192411648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, { FIXED [Customer_ID] : MAX([Order_Date]) }, { MAX([Order_Date]) })' />
            </column>
            <column caption='Frequency' datatype='integer' name='[Calculation_0141564192653313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Customer_ID] : COUNTD([Order_ID]) }' />
            </column>
            <column caption='Monetary' datatype='real' name='[Calculation_0141564192792578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Customer_ID] : SUM([Net_Revenue_USD]) }' />
            </column>
            <column caption='R Score' datatype='integer' name='[Calculation_0141564193234947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_0141564192411648] &lt;= 107 THEN 3 ELSEIF [Calculation_0141564192411648] &lt;= 309 THEN 2 ELSE 1 END' />
            </column>
            <column caption='F Score' datatype='integer' name='[Calculation_0141564193816580]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_0141564192653313] &gt;= 5 THEN 3 ELSEIF [Calculation_0141564192653313] = 4 THEN 2 ELSE 1 END' />
            </column>
            <column caption='M Score' datatype='integer' name='[Calculation_0141564193976325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_0141564192792578] &gt; 760 THEN 3 ELSEIF [Calculation_0141564192792578] &gt; 432 THEN 2 ELSE 1 END' />
            </column>
            <column caption='RFM Segment ' datatype='string' name='[Calculation_0141564194115590]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0141564193234947]+[Calculation_0141564193816580]+[Calculation_0141564193976325] &gt;= 8 THEN &quot;Champions&quot;&#13;&#10;ELSEIF [Calculation_0141564193234947]+[Calculation_0141564193816580]+[Calculation_0141564193976325] &gt;= 6 THEN &quot;Loyal&quot;&#13;&#10;ELSEIF [Calculation_0141564193234947]+[Calculation_0141564193816580]+[Calculation_0141564193976325] &gt;= 4 THEN &quot;At Risk&quot;&#13;&#10;ELSE &quot;Lost&quot; END' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Customer ID' datatype='string' name='[Customer_ID]' role='dimension' type='nominal' />
            <column caption='Net Revenue USD' datatype='real' name='[Net_Revenue_USD]' role='measure' type='quantitative' />
