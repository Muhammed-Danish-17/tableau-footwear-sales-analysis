    <worksheet name='Brand Scatter Plot'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Benton Sans Book'>Brand Performance – Revenue vs Profit</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='footwear_orders_100k+ (footwear_extra_dimension_tables)' name='federated.0j495kw0i1sa6810dumqo0buc8yy' />
          </datasources>
          <datasource-dependencies datasource='federated.0j495kw0i1sa6810dumqo0buc8yy'>
            <column datatype='string' name='[Brand]' role='dimension' type='nominal' />
            <column caption='Total Revenue' datatype='real' name='[Calculation_1534159812132864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Net_Revenue_USD])' />
            </column>
            <column caption='Total Profit' datatype='real' name='[Calculation_1534159812284417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Profit_USD])' />
            </column>
            <column caption='Total Orders' datatype='integer' name='[Calculation_1534159812485122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Order_ID])' />
            </column>
            <column caption='Profit Margin' datatype='real' name='[Calculation_1534159812755460]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Profit_USD])&#13;&#10;/&#13;&#10;SUM([Net_Revenue_USD])' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
            <column caption='Net Revenue USD' datatype='real' name='[Net_Revenue_USD]' role='measure' type='quantitative' />
            <column caption='Order ID' datatype='string' name='[Order_ID]' role='dimension' type='nominal' />
            <column caption='Profit USD' datatype='real' name='[Profit_USD]' role='measure' type='quantitative' />
            <column-instance column='[Brand]' derivation='None' name='[none:Brand:nk]' pivot='key' type='nominal' />
            <column-instance column='[Gender]' derivation='None' name='[none:Gender:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1534159812132864]' derivation='User' name='[usr:Calculation_1534159812132864:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1534159812284417]' derivation='User' name='[usr:Calculation_1534159812284417:qk]' pivot='key' type='quantitative' />
