            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column caption='Target Net Revenue USD' datatype='real' name='[Target_Net_Revenue_USD]' role='measure' type='quantitative' />
            <column-instance column='[Region]' derivation='None' name='[none:Region:nk]' pivot='key' type='nominal' />
            <column-instance column='[Net_Revenue_USD]' derivation='Sum' name='[sum:Net_Revenue_USD:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Target_Net_Revenue_USD]' derivation='Sum' name='[sum:Target_Net_Revenue_USD:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0j495kw0i1sa6810dumqo0buc8yy].[Action (Brand,Region)]'>
