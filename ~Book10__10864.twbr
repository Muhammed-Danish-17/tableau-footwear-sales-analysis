      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0j495kw0i1sa6810dumqo0buc8yy].[usr:Calculation_1534159812988933:qk]&quot;' value='AOV' />
